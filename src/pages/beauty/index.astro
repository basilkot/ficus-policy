---
import Page from '../../layouts/Page.astro'
import AppGate from '../../components/AppGate.astro'
import AppStory from '../../components/AppStory.astro'
import { appBySlug } from '../../data/apps'

const app = appBySlug('beauty')
---

<Page
  lang="en"
  title={`${app.name} — makeup expiration tracker`}
  description="Keeps track of what is in your makeup bag and reminds you before it expires. Free on iPhone and Android."
  preview="/beauty/preview.png"
  alternate={[
    { lang: 'en', href: '/beauty' },
    { lang: 'ru', href: '/ru/beauty' },
    { lang: 'x-default', href: '/beauty' },
  ]}
>
  <AppGate app={app} lang="en">
    <AppStory app={app} lang="en" />
  </AppGate>
</Page>
