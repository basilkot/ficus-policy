---
import Page from '../layouts/Page.astro'
import { apps } from '../data/apps'

// Корень — указатель, а не витрина: рассказ про каждое приложение живёт на его
// странице, и разводить второй такой же рассказ здесь значит конкурировать
// с ним по одному и тому же запросу.
//
// Документов здесь нет намеренно. Карточки сторов ссылаются прямо на конечные
// адреса, а десять ссылок в политики с самой сильной страницы домена сообщали
// поисковику, что сайт про политики. Опись переехала на `/legal`
---

<Page lang="en" title="Ficus Apps" description="Small apps for everyday things.">
  <main>
    <h1>Ficus Apps</h1>
    <p class="lead">Small apps for everyday things.</p>

    <ul>
      {
        apps.map((app) => (
          <li>
            <a href={`/${app.slug}?from=site`}>
              <img src={app.icon} alt="" width="48" height="48" />
              <span>
                <strong>{app.name}</strong>
                <em>{app.tagline.en}</em>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <footer>
      <a href="/legal">Legal</a>
    </footer>
  </main>
</Page>

<style>
  h1 { font-size: 28px; margin: 0 0 4px; }
  .lead { color: var(--muted); margin: 0 0 36px; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { border-top: 1px solid var(--line); }
  li:last-child { border-bottom: 1px solid var(--line); }

  li a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0;
    color: var(--text);
    text-decoration: none;
  }

  img { border-radius: 11px; }

  strong { display: block; font-size: 17px; }
  em { display: block; font-style: normal; color: var(--muted); font-size: 15px; }

  footer { margin-top: 40px; font-size: 14px; }
  footer a { color: var(--muted); }
</style>
