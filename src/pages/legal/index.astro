---
import Page from '../../layouts/Page.astro'
import { documents } from '../../data/documents'

// Опись документов. Отдельной страницей, а не на корне: карточки сторов ссылаются
// прямо на конечные адреса, а список на главной уводил вес туда, куда по своей воле
// не ходят, и сообщал поисковику, что сайт про политики
---

<Page lang="en" title="Legal — Ficus Apps" description="Privacy policies, terms and support pages for Ficus Apps.">
  <main>
    <p class="back"><a href="/">Ficus Apps</a></p>

    <h1>Legal</h1>
    <p class="lead">
      Privacy policies, terms and support pages — the addresses the app store listings point at.
    </p>

    <ul>
      {
        documents.map((document) => (
          <li>
            <a href={document.href}>
              <span>
                <strong>{document.title}</strong>
                <em>{document.note}</em>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Page>

<style>
  .back { margin: 0 0 28px; font-size: 15px; }
  h1 { font-size: 28px; margin: 0 0 4px; }
  .lead { color: var(--muted); margin: 0 0 24px; font-size: 15px; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { border-top: 1px solid var(--line); }
  li:last-child { border-bottom: 1px solid var(--line); }

  li a {
    display: block;
    padding: 14px 0;
    color: var(--text);
    text-decoration: none;
  }

  strong { display: block; font-weight: 600; font-size: 16px; }
  em { display: block; font-style: normal; color: var(--muted); font-size: 15px; }
</style>
