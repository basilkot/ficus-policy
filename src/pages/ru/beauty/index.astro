---
import Page from '../../../layouts/Page.astro'
import AppGate from '../../../components/AppGate.astro'
import { appBySlug } from '../../../data/apps'

const app = appBySlug('beauty')
---

<Page
  lang="ru"
  title={`${app.name} — установить`}
  description={app.tagline.ru}
  preview="/beauty/icon.png"
  alternate={[
    { lang: 'en', href: '/beauty' },
    { lang: 'ru', href: '/ru/beauty' },
    { lang: 'x-default', href: '/beauty' },
  ]}
>
  <AppGate app={app} lang="ru" />
</Page>
